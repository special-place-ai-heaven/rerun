{
    "name": "rerun-desktop",
    "productName": "Rerun",
    "description": "Rerun for macOS, Windows and Linux",
    "license": "AGPL-3.0-only",
    "version": "0.1.1",
    "private": true,
    "type": "module",
    "author": {
        "name": "Rerun",
        "email": "help@rerun.build"
    },
    "homepage": "https://rerun.build",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "ts-check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "test": "vitest run",
        "icons": "node scripts/make-icons.mjs",
        "package": "electron-vite build && electron-builder --config electron-builder.config.ts --publish never",
        "package:dir": "electron-vite build && electron-builder --config electron-builder.config.ts --publish never --dir"
    },
    "dependencies": {
        "electron-updater": "6.8.11"
    },
    "devDependencies": {
        "@electron/fuses": "2.1.3",
        "@rerun/contracts": "workspace:^",
        "@rerun/i18n": "workspace:^",
        "@rerun/ui": "workspace:^",
        "@tailwindcss/vite": "^4",
        "@types/node": "^24",
        "@types/react": "^19.2.16",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "6.3.0",
        "electron": "45.3.1",
        "electron-builder": "26.18.0",
        "electron-vite": "6.0.0",
        "lucide-react": "^1.64.0",
        "playwright": "1.65.0",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "sharp": "^0.35.5",
        "tailwindcss": "^4",
        "typescript": "^5.8.3",
        "use-intl": "^4.14.9",
        "vite": "^8.3.5",
        "vitest": "^4.1.8"
    }
}
