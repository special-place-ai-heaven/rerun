{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node", "vite/client"]
    },
    "include": ["electron.vite.config.ts", "electron-builder.config.ts", "build-config.ts", "src/env.d.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "test/**/*", "e2e/**/*", "scripts/**/*.ts", "vitest.config.ts"]
}
