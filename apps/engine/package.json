{
    "name": "rerun-engine",
    "license": "AGPL-3.0-only",
    "type": "module",
    "bin": {
        "rerun": "./dist/cli/bin.js"
    },
    "files": [
        "dist",
        "assets",
        "patches"
    ],
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/cli/bin.ts run",
        "build": "tsc",
        "lint": "eslint .",
        "start": "node dist/cli/bin.js run",
        "migrate": "tsx src/cli/bin.ts migrate",
        "ts-check": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.142",
        "@ai-sdk/google": "^3.0.145",
        "@ai-sdk/openai": "^3.0.141",
        "@hono/node-server": "^1.19.19",
        "@libsql/client": "^0.18.0",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@rerun/contracts": "workspace:*",
        "ai": "^6.0.330",
        "ai-sdk-provider-claude-code": "^3.7.1",
        "ai-sdk-provider-codex-cli": "^1.6.0",
        "croner": "^10.0.1",
        "drizzle-orm": "^0.45.4",
        "gray-matter": "^4.0.3",
        "hono": "^4.13.18",
        "nanoid": "^5.1.16",
        "patchright": "^1.64.3",
        "pino": "^10.4.0",
        "pxpipe-proxy": "^0.16.0",
        "sharp": "^0.35.5",
        "tar": "^7.5.22",
        "undici": "^7.30.2",
        "ws": "^8.22.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^20.19.43",
        "@types/ws": "^8.18.2",
        "@vitest/coverage-v8": "4.1.12",
        "eslint": "^9.39.5",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.2",
        "vitest": "^4.1.12"
    }
}
