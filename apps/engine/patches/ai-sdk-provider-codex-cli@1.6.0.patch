+    webSearchItemSchema,
+    imageViewItemSchema,
+    enteredReviewModeItemSchema,
+    exitedReviewModeItemSchema,
+    contextCompactionItemSchema,
+    imageGenerationItemSchema
+  ]),
+  unknownItemSchema
 ]);
