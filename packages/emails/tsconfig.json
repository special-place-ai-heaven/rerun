{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "noEmit": true,
        "verbatimModuleSyntax": false,
        "resolveJsonModule": true
    },
    "include": ["*.ts", "src/**/*.ts", "src/**/*.tsx", "emails/**/*.tsx", "components/**/*.tsx"]
}
