{
  "version": 1,
  "coworkers": {
    "advisor": {"class": "rule", "github": "reviewer", "wake": ["request from Rob", "second reject by one owner on a job"]},
    "boss": {"class": "rule", "github": "issues", "wake": ["ready queue short", "plan marked ready"]},
    "ike": {"class": "plan", "github": "none", "wake": ["new job"]},
    "scope_shaper": {"class": "plan", "github": "issues", "wake": ["new job", "plan requested"]},
    "idea_partner": {"class": "plan", "github": "none", "wake": ["message from Rob", "issue labelled idea"]},
    "ada": {"class": "plan", "github": "reviewer", "wake": ["change over 25 files or 1200 lines", "cross-area change"]},
    "devils_advocate": {"class": "plan", "github": "reviewer", "wake": ["plan marked ready"]},
    "code": {"class": "build", "github": "writer", "wake": ["ready chunk"]},
    "larry": {"class": "build", "github": "writer", "wake": ["ready chunk"]},
    "hopper": {"class": "build", "github": "writer", "wake": ["ready chunk", "merged screen change"]},
    "martin": {"class": "build", "github": "writer", "wake": ["ready chunk"]},
    "house": {"class": "build", "github": "writer", "wake": ["same check failing twice", "job blocked after its retry"]},
    "kent": {"class": "build", "github": "writer", "wake": ["merged logic with no test"]},
    "codd": {"class": "build", "github": "writer", "wake": ["ready chunk", "change in the data area"]},
    "dana": {"class": "build", "github": "writer", "wake": ["merge that changes behaviour"]},
    "changelog_writer": {"class": "build", "github": "reviewer", "wake": ["merge into dev that changes behaviour"]},
    "margaret": {"class": "build", "github": "writer", "wake": ["ready chunk", "merge into main", "job reaching READY", "failed health check"]},
    "jez": {"class": "build", "github": "writer", "wake": ["failed check on dev or main"]},
    "junio": {"class": "build", "github": "writer", "wake": ["conflict left after one builder attempt"]},
    "bill": {"class": "build", "github": "none", "wake": ["change to a screen", "design question on an issue"]},
    "grace": {"class": "advise", "github": "reviewer", "wake": ["change to a contract file"]},
    "leslie": {"class": "advise", "github": "reviewer", "wake": ["cross-area change"]},
    "brendan": {"class": "advise", "github": "writer", "wake": ["timing or size figure past its limit"]},
    "charity": {"class": "advise", "github": "reviewer", "wake": ["failed health check"]},
    "holmes": {"class": "advise", "github": "none", "wake": ["plan with an open question", "decision issue"]},
    "search": {"class": "advise", "github": "none", "wake": ["plan with an open question"]},
    "prior_art_scout": {"class": "advise", "github": "none", "wake": ["plan with an open question", "new idea"]},
    "dieter": {"class": "advise", "github": "reviewer", "wake": ["change to a screen", "design question on an issue"]},
    "linus": {"class": "gate", "github": "reviewer", "wake": ["green checks on a chunk PR"]},
    "bruce": {"class": "gate", "github": "reviewer", "wake": ["green checks on a sensitive area"]},
    "barbara": {"class": "gate", "github": "reviewer", "wake": ["job reaching READY"]},
    "fred": {"class": "gate", "github": "reviewer", "wake": ["merged screen change"]},
    "botsitter": {"class": "gate", "github": "reviewer", "wake": ["coworker reporting done"]},
    "warden": {"class": "watch", "github": "none", "wake": ["daily"]},
    "box_janitor": {"class": "watch", "github": "none", "wake": ["daily"]},
    "agent_smith": {"class": "watch", "github": "none", "wake": ["weekly"]},
    "plugin_scout": {"class": "watch", "github": "none", "wake": ["on request"]},
    "issue_triage": {"class": "watch", "github": "issues", "wake": ["new issue", "its two existing timers"]}
  },
  "areas": [
    {"name": "tests", "owner": "linus", "builder": "kent", "sensitive": false, "globs": [
      "**/*.test.*", "**/*.spec.*", "**/test_*.py", "**/*_test.py", "**/*_test.go",
      "**/tests/**", "**/test/**", "**/__tests__/**"]},
    {"name": "docs", "owner": "linus", "builder": "dana", "sensitive": false, "globs": [
      "**/*.md", "docs/**", "doc/**"]},
    {"name": "factory-roster", "owner": "linus", "builder": "code", "sensitive": true, "globs": [
      "tools/factory/roster.json", "tools/factory/roster.py"]},
    {"name": "factory-tools", "owner": "linus", "builder": "code", "sensitive": false, "globs": [
      "tools/factory/**"]},
    {"name": "engine-start", "owner": "margaret", "builder": "margaret", "sensitive": true, "globs": [
      "**/Dockerfile*", "**/docker-compose*.yml", "apps/engine/docker-entrypoint.sh",
      "apps/engine/scripts/entrypoint*.sh", "deploy/**", "apps/engine/src/config/**"]},
    {"name": "auth-secrets", "owner": "bruce", "builder": "stack", "sensitive": true, "globs": [
      "**/*auth*", "**/*auth*/**", "**/*oidc*", "**/*oidc*/**", "**/*keycloak*", "**/*keycloak*/**",
      "**/*login*", "**/*login*/**", "**/*session*", "**/*session*/**", "**/*token*", "**/*token*/**",
      "**/*secret*", "**/*secret*/**", "**/*password*", "**/*password*/**", "**/*crypto*", "**/*crypto*/**",
      "**/*permission*", "**/*permission*/**", "**/*guard*", "**/*guard*/**", "**/*role*", "**/*role*/**",
      "**/*cors*", "**/*cors*/**", "**/*csrf*", "**/*csrf*/**", "**/*sanitize*", "**/*sanitize*/**",
      "**/*upload*", "**/*upload*/**",
      "**/package.json", "**/package-lock.json", "**/pnpm-lock.yaml", "**/yarn.lock",
      "**/Cargo.toml", "**/Cargo.lock", "**/requirements*.txt", "**/pyproject.toml"]},
    {"name": "data", "owner": "codd", "builder": "codd", "sensitive": false, "globs": [
      "**/*migration*", "**/*migration*/**", "**/*schema*", "**/*schema*/**", "**/*.sql", "**/*.entity.ts",
      "**/*prisma*", "**/*prisma*/**", "**/*typeorm*", "**/*typeorm*/**", "**/*seed*", "**/*seed*/**"]},
    {"name": "api-contract", "owner": "grace", "builder": "stack", "sensitive": false, "globs": [
      "**/*openapi*", "**/*openapi*/**", "**/*swagger*", "**/*swagger*/**", "**/*.controller.ts",
      "**/*.dto.ts", "**/*.proto", "**/api/**", "**/*contract*", "**/*contract*/**"]},
    {"name": "ui", "owner": "dieter", "builder": "hopper", "sensitive": false, "globs": [
      "**/*.scss", "**/*.css", "**/*.html", "**/*.svg", "**/*theme*", "**/*theme*/**",
      "**/*design-tokens*", "frontend/**/*.ts", "frontend/**/*.tsx"]},
    {"name": "rust", "owner": "linus", "builder": "larry", "sensitive": false, "globs": [
      "**/*.rs", "crates/**"]}
  ],
  "default": {"owner": "linus", "builder": "code"}
}
